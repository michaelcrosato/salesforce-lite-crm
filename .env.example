# Required: local SQLite database (the default runtime). Postgres is a promoted
# non-goal — see README "Postgres Switching Notes".
DATABASE_URL="file:./prisma/dev.db"

# Optional: structured-log verbosity — debug | info | warn | error | silent.
# Defaults to "info" (and "silent" under NODE_ENV=test). See lib/observability/logger.ts.
# LOG_LEVEL="info"

# Optional: port for the Playwright e2e dev server. Defaults to 3004.
# See playwright.config.ts.
# PLAYWRIGHT_PORT="3004"
