{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "cycle_id", "mode", "dispatch"],
  "properties": {
    "schema_version": { "const": 1 },
    "cycle_id": { "type": "string" },
    "mode": { "enum": ["DryRun", "FailSafe", "MaxAutonomy", "ReviewOnly"] },
    "rationale": { "type": "string" },
    "dispatch": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "agent", "role", "worktree", "branch", "prompt_template", "allowed_zones", "gate", "max_attempts"],
        "properties": {
          "task_id": { "type": "string" },
          "agent": { "enum": ["codex", "claude", "grok", "gemini"] },
          "role": { "enum": ["worker", "reviewer"] },
          "worktree": { "type": "string" },
          "branch": { "type": "string" },
          "prompt_template": { "type": "string" },
          "allowed_zones": { "type": "array", "items": { "type": "string" } },
          "gate": { "type": "array", "items": { "type": "string" } },
          "fallback_agents": { "type": "array", "items": { "enum": ["codex", "claude", "grok", "gemini"] } },
          "review_agents": { "type": "array", "items": { "enum": ["codex", "claude", "grok", "gemini"] } },
          "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
          "parallel_safe": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "no_dispatch": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "reason"],
        "properties": {
          "task_id": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
