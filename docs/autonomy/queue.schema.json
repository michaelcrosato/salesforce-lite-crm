{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "repo", "mode", "tasks"],
  "properties": {
    "schema_version": { "const": 1 },
    "repo": { "type": "string" },
    "mode": { "enum": ["DryRun", "FailSafe", "MaxAutonomy", "ReviewOnly"] },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "allowed_zones", "preferred_agents", "prompt_template", "gate", "max_worker_attempts"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["queued", "active", "done", "blocked"] },
          "risk": { "type": "string" },
          "priority": { "type": "integer" },
          "allowed_zones": { "type": "array", "items": { "type": "string" } },
          "preferred_agents": { "type": "array", "items": { "enum": ["codex", "claude", "grok", "gemini"] } },
          "fallback_agents": { "type": "array", "items": { "enum": ["codex", "claude", "grok", "gemini"] } },
          "review_agents": { "type": "array", "items": { "enum": ["codex", "claude", "grok", "gemini"] } },
          "parallel_safe": { "type": "boolean" },
          "prompt_template": { "type": "string" },
          "gate": { "type": "array", "items": { "type": "string" } },
          "max_worker_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
          "last_status_reason": { "type": "string" },
          "updated_at": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
