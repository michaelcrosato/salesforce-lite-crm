{
  "name": "salesforce-lite-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "config": {
    "playwright_browsers_path": "0"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-sqlite-db.mjs",
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:e2e": "npm run seed && playwright test",
    "prisma:postgres": "node scripts/prisma-postgres.mjs",
    "agent:bootstrap": "npm install && npx prisma generate && npx prisma db push && npm run seed",
    "agent:check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "agent:format": "node -e \"console.log('format: no formatter configured (skipped)')\"",
    "agent:status": "git status --short --branch",
    "autonomy:overnight": "powershell -ExecutionPolicy Bypass -File scripts/autonomy-loop.ps1",
    "autonomy:watchdog": "powershell -ExecutionPolicy Bypass -File scripts/start-codex-overnight.ps1"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "postcss": "8.5.15"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-slot": "1.2.4",
    "better-sqlite3": "12.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "lucide-react": "0.577.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.1",
    "tailwind-merge": "2.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "postcss": "8.5.15",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
