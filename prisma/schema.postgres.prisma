generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(cuid()) @db.Text
  name       String     @db.VarChar(255)
  email      String     @unique @db.VarChar(255)
  role       String     @default("sales") @db.VarChar(50)
  createdAt  DateTime   @default(now()) @db.Timestamp(3)
  updatedAt  DateTime   @updatedAt @db.Timestamp(3)
  accounts   Account[]
  deals      Deal[]
  activities Activity[]
  tasks      Task[]
  cases      Case[]
  campaigns  Campaign[]
  opportunityStageChanges OpportunityStageHistory[]
  auditEvents AuditEvent[]
}

model SavedListView {
  id          String   @id @default(cuid()) @db.Text
  entity      String   @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  filters     String   @default("{}") @db.Text
  sortBy      String   @db.VarChar(80)
  sortOrder   String   @default("asc") @db.VarChar(10)
  pageSize    Int?     @db.Integer
  createdAt   DateTime @default(now()) @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @db.Timestamp(3)

  @@unique([entity, name])
  @@index([entity])
  @@index([updatedAt])
}

model Account {
  id          String     @id @default(cuid()) @db.Text
  name        String     @db.VarChar(255)
  domain      String?    @db.VarChar(255)
  industry    String?    @db.VarChar(120)
  city        String?    @db.VarChar(120)
  region      String?    @db.VarChar(120)
  status      String     @db.VarChar(50)
  ownerId     String?    @db.Text
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  healthScore Int        @default(80) @db.Integer
  createdAt   DateTime   @default(now()) @db.Timestamp(3)
  updatedAt   DateTime   @updatedAt @db.Timestamp(3)
  contacts    Contact[]
  deals       Deal[]
  activities  Activity[]
  dealerOrders DealerOrder[]
  tasks       Task[]
  cases       Case[]

  @@index([ownerId])
  @@index([status])
}

model Area {
  id             String            @id @default(cuid()) @db.Text
  name           String            @db.VarChar(255)
  province       String?           @db.VarChar(80)
  region         String?           @db.VarChar(120)
  postalPrefixes String            @db.Text
  createdAt      DateTime          @default(now()) @db.Timestamp(3)
  updatedAt      DateTime          @updatedAt @db.Timestamp(3)
  dealerOrders   DealerOrderArea[]
  leads          Lead[]

  @@index([name])
  @@index([province])
}

model DealerOrder {
  id           String            @id @default(cuid()) @db.Text
  accountId    String            @db.Text
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String            @db.VarChar(255)
  monthlyQuota Int               @db.Integer
  status       String            @db.VarChar(50)
  startDate    DateTime          @db.Timestamp(3)
  endDate      DateTime?         @db.Timestamp(3)
  createdAt    DateTime          @default(now()) @db.Timestamp(3)
  updatedAt    DateTime          @updatedAt @db.Timestamp(3)
  areas        DealerOrderArea[]
  leads        Lead[]

  @@index([accountId])
  @@index([status])
  @@index([startDate])
}

model DealerOrderArea {
  id            String      @id @default(cuid()) @db.Text
  dealerOrderId String      @db.Text
  dealerOrder   DealerOrder @relation(fields: [dealerOrderId], references: [id], onDelete: Cascade)
  areaId        String      @db.Text
  area          Area        @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([dealerOrderId, areaId])
  @@index([areaId])
}

model Lead {
  id               String       @id @default(cuid()) @db.Text
  firstName        String       @db.VarChar(120)
  lastName         String       @db.VarChar(120)
  phone            String?      @db.VarChar(80)
  email            String?      @db.VarChar(255)
  postalCode       String?      @db.VarChar(20)
  province         String?      @db.VarChar(80)
  source           String?      @db.VarChar(120)
  status           String       @db.VarChar(50)
  areaId           String?      @db.Text
  area             Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  assignedOrderId  String?      @db.Text
  assignedOrder    DealerOrder? @relation(fields: [assignedOrderId], references: [id], onDelete: SetNull)
  assignmentReason String?      @db.VarChar(120)
  createdAt        DateTime     @default(now()) @db.Timestamp(3)
  updatedAt        DateTime     @updatedAt @db.Timestamp(3)
  activities       Activity[]
  tasks            Task[]
  campaigns        Campaign[]   @relation("CampaignLeads")

  @@index([areaId])
  @@index([assignedOrderId])
  @@index([status])
  @@index([createdAt])
}

model Contact {
  id         String     @id @default(cuid()) @db.Text
  accountId  String?    @db.Text
  account    Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  firstName  String     @db.VarChar(120)
  lastName   String     @db.VarChar(120)
  email      String?    @unique @db.VarChar(255)
  phone      String?    @db.VarChar(80)
  title      String?    @db.VarChar(255)
  status     String     @db.VarChar(50)
  createdAt  DateTime   @default(now()) @db.Timestamp(3)
  updatedAt  DateTime   @updatedAt @db.Timestamp(3)
  deals      Deal[]
  activities Activity[]
  tasks      Task[]
  cases      Case[]
  campaigns  Campaign[] @relation("CampaignContacts")

  @@index([accountId])
  @@index([status])
}

model Deal {
  id                String     @id @default(cuid()) @db.Text
  accountId         String?    @db.Text
  account           Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId         String?    @db.Text
  contact           Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId           String?    @db.Text
  owner             User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  name              String     @db.VarChar(255)
  stage             String     @db.VarChar(50)
  value             Int        @db.Integer
  probability       Int        @db.Integer
  expectedCloseDate DateTime?  @db.Timestamp(3)
  lastActivityAt    DateTime?  @db.Timestamp(3)
  createdAt         DateTime   @default(now()) @db.Timestamp(3)
  updatedAt         DateTime   @updatedAt @db.Timestamp(3)
  activities        Activity[]
  tasks             Task[]
  stageHistory      OpportunityStageHistory[]

  @@index([accountId])
  @@index([contactId])
  @@index([ownerId])
  @@index([stage])
  @@index([lastActivityAt])
}

model Activity {
  id        String   @id @default(cuid()) @db.Text
  accountId String?  @db.Text
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId String?  @db.Text
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId    String?  @db.Text
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  leadId    String?  @db.Text
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  taskId    String?  @db.Text
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  caseId    String?  @db.Text
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  userId    String?  @db.Text
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(255)
  rawText   String?  @db.Text
  summary   String?  @db.Text
  nextStep  String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([accountId])
  @@index([contactId])
  @@index([dealId])
  @@index([leadId])
  @@index([taskId])
  @@index([caseId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Task {
  id          String    @id @default(cuid()) @db.Text
  title       String    @db.VarChar(255)
  description String?   @db.Text
  dueDate     DateTime? @db.Timestamp(3)
  status      String    @default("open") @db.VarChar(50)
  priority    String    @default("normal") @db.VarChar(50)
  ownerId     String?   @db.Text
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  accountId   String?   @db.Text
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId   String?   @db.Text
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?   @db.Text
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  leadId      String?   @db.Text
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities  Activity[]
  createdAt   DateTime  @default(now()) @db.Timestamp(3)
  updatedAt   DateTime  @updatedAt @db.Timestamp(3)

  @@index([status])
  @@index([ownerId])
  @@index([dueDate])
}

model Case {
  id          String    @id @default(cuid()) @db.Text
  subject     String    @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("new") @db.VarChar(50)
  priority    String    @default("normal") @db.VarChar(50)
  accountId   String?   @db.Text
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId   String?   @db.Text
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId     String?   @db.Text
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  activities  Activity[]
  createdAt   DateTime  @default(now()) @db.Timestamp(3)
  updatedAt   DateTime  @updatedAt @db.Timestamp(3)

  @@index([status])
  @@index([accountId])
}

model Campaign {
  id          String    @id @default(cuid()) @db.Text
  name        String    @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("planned") @db.VarChar(50)
  startDate   DateTime? @db.Timestamp(3)
  endDate     DateTime? @db.Timestamp(3)
  budget      Int?      @db.Integer
  ownerId     String?   @db.Text
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  leads       Lead[]    @relation("CampaignLeads")
  contacts    Contact[] @relation("CampaignContacts")
  createdAt   DateTime  @default(now()) @db.Timestamp(3)
  updatedAt   DateTime  @updatedAt @db.Timestamp(3)

  @@index([status])
}

model OpportunityStageHistory {
  id              String   @id @default(cuid()) @db.Text
  dealId          String   @db.Text
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage       String?  @db.VarChar(50)
  toStage         String   @db.VarChar(50)
  changedAt       DateTime @default(now()) @db.Timestamp(3)
  changedByUserId String?  @db.Text
  changedByUser   User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([changedAt])
  @@index([changedByUserId])
}

model AuditEvent {
  id          String   @id @default(cuid()) @db.Text
  category    String   @db.VarChar(50)
  action      String   @db.VarChar(120)
  actorUserId String?  @db.Text
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  entityType  String?  @db.VarChar(80)
  entityId    String?  @db.Text
  summary     String   @db.Text
  metadata    String?  @db.Text
  occurredAt  DateTime @default(now()) @db.Timestamp(3)
  createdAt   DateTime @default(now()) @db.Timestamp(3)

  @@index([category])
  @@index([action])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([occurredAt])
}
