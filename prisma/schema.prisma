generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  role       String     @default("sales")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  accounts   Account[]
  deals      Deal[]
  activities Activity[]
}

model Account {
  id          String     @id @default(cuid())
  name        String
  domain      String?
  industry    String?
  city        String?
  region      String?
  status      String
  ownerId     String?
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  healthScore Int        @default(80)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  contacts    Contact[]
  deals       Deal[]
  activities  Activity[]
  dealerOrders DealerOrder[]

  @@index([ownerId])
  @@index([status])
}

model Area {
  id             String            @id @default(cuid())
  name           String
  province       String?
  region         String?
  postalPrefixes String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  dealerOrders   DealerOrderArea[]
  leads          Lead[]

  @@index([name])
  @@index([province])
}

model DealerOrder {
  id           String            @id @default(cuid())
  accountId    String
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  monthlyQuota Int
  status       String
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  areas        DealerOrderArea[]
  leads        Lead[]

  @@index([accountId])
  @@index([status])
  @@index([startDate])
}

model DealerOrderArea {
  id            String      @id @default(cuid())
  dealerOrderId String
  dealerOrder   DealerOrder @relation(fields: [dealerOrderId], references: [id], onDelete: Cascade)
  areaId        String
  area          Area        @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([dealerOrderId, areaId])
  @@index([areaId])
}

model Lead {
  id               String       @id @default(cuid())
  firstName        String
  lastName         String
  phone            String?
  email            String?
  postalCode       String?
  province         String?
  source           String?
  status           String
  areaId           String?
  area             Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  assignedOrderId  String?
  assignedOrder    DealerOrder? @relation(fields: [assignedOrderId], references: [id], onDelete: SetNull)
  assignmentReason String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  activities       Activity[]

  @@index([areaId])
  @@index([assignedOrderId])
  @@index([status])
  @@index([createdAt])
}

model Contact {
  id         String     @id @default(cuid())
  accountId  String?
  account    Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  firstName  String
  lastName   String
  email      String?    @unique
  phone      String?
  title      String?
  status     String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deals      Deal[]
  activities Activity[]

  @@index([accountId])
  @@index([status])
}

model Deal {
  id                String     @id @default(cuid())
  accountId         String?
  account           Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId         String?
  contact           Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId           String?
  owner             User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  name              String
  stage             String
  value             Int
  probability       Int
  expectedCloseDate DateTime?
  lastActivityAt    DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  activities        Activity[]

  @@index([accountId])
  @@index([contactId])
  @@index([ownerId])
  @@index([stage])
  @@index([lastActivityAt])
}

model Activity {
  id        String   @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  title     String
  rawText   String?
  summary   String?
  nextStep  String?
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([contactId])
  @@index([dealId])
  @@index([leadId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}
