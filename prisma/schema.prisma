generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  role       String     @default("sales")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  accounts   Account[]
  deals      Deal[]
  activities Activity[]
  tasks      Task[]
  cases      Case[]
  campaigns  Campaign[]
  opportunityStageChanges OpportunityStageHistory[]
  auditEvents AuditEvent[]
  knowledgeArticles KnowledgeArticle[]
}

model SavedListView {
  id          String   @id @default(cuid())
  entity      String
  name        String
  description String?
  filters     String   @default("{}")
  sortBy      String
  sortOrder   String   @default("asc")
  pageSize    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entity, name])
  @@index([entity])
  @@index([updatedAt])
}

model Account {
  id          String     @id @default(cuid())
  name        String
  domain      String?
  industry    String?
  city        String?
  region      String?
  status      String
  ownerId     String?
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  healthScore Int        @default(80)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  contacts    Contact[]
  deals       Deal[]
  activities  Activity[]
  dealerOrders DealerOrder[]
  tasks       Task[]
  cases       Case[]

  @@index([ownerId])
  @@index([status])
}

model Area {
  id             String            @id @default(cuid())
  name           String
  province       String?
  region         String?
  postalPrefixes String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  dealerOrders   DealerOrderArea[]
  leads          Lead[]

  @@index([name])
  @@index([province])
}

model DealerOrder {
  id           String            @id @default(cuid())
  accountId    String
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  monthlyQuota Int
  status       String
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  areas        DealerOrderArea[]
  leads        Lead[]

  @@index([accountId])
  @@index([status])
  @@index([startDate])
}

model DealerOrderArea {
  id            String      @id @default(cuid())
  dealerOrderId String
  dealerOrder   DealerOrder @relation(fields: [dealerOrderId], references: [id], onDelete: Cascade)
  areaId        String
  area          Area        @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([dealerOrderId, areaId])
  @@index([areaId])
}

model Lead {
  id               String       @id @default(cuid())
  firstName        String
  lastName         String
  phone            String?
  email            String?
  postalCode       String?
  province         String?
  source           String?
  status           String
  areaId           String?
  area             Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  assignedOrderId  String?
  assignedOrder    DealerOrder? @relation(fields: [assignedOrderId], references: [id], onDelete: SetNull)
  assignmentReason String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  activities       Activity[]
  tasks            Task[]
  campaigns        Campaign[]   @relation("CampaignLeads")

  @@index([areaId])
  @@index([assignedOrderId])
  @@index([status])
  @@index([createdAt])
}

model Contact {
  id         String     @id @default(cuid())
  accountId  String?
  account    Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  firstName  String
  lastName   String
  email      String?    @unique
  phone      String?
  title      String?
  status     String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deals      Deal[]
  activities Activity[]
  tasks      Task[]
  cases      Case[]
  campaigns  Campaign[] @relation("CampaignContacts")

  @@index([accountId])
  @@index([status])
}

model Deal {
  id                String     @id @default(cuid())
  accountId         String?
  account           Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId         String?
  contact           Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId           String?
  owner             User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  name              String
  stage             String
  value             Int
  probability       Int
  expectedCloseDate DateTime?
  lastActivityAt    DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  activities        Activity[]
  tasks             Task[]
  stageHistory      OpportunityStageHistory[]

  @@index([accountId])
  @@index([contactId])
  @@index([ownerId])
  @@index([stage])
  @@index([lastActivityAt])
}

model Activity {
  id        String   @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  title     String
  rawText   String?
  summary   String?
  nextStep  String?
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([contactId])
  @@index([dealId])
  @@index([leadId])
  @@index([taskId])
  @@index([caseId])
  @@index([userId])
  @@index([type])
  @@index([leadId, type, createdAt])
  @@index([createdAt])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("open")
  priority    String    @default("normal")
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities  Activity[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([dueDate])
}

model Case {
  id          String    @id @default(cuid())
  subject     String
  description String?
  status      String    @default("new")
  priority    String    @default("normal")
  queueKey    String    @default("general_support")
  queueReason String?
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  activities  Activity[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([queueKey])
  @@index([accountId])
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("planned")
  startDate   DateTime?
  endDate     DateTime?
  budget      Int?
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  leads       Lead[]    @relation("CampaignLeads")
  contacts    Contact[] @relation("CampaignContacts")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model KnowledgeArticle {
  id           String    @id @default(cuid())
  title        String
  summary      String?
  body         String
  status       String    @default("draft")
  audience     String    @default("internal")
  category     String?
  keywords     String    @default("")
  caseQueueKey String?
  ownerId      String?
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([audience])
  @@index([category])
  @@index([caseQueueKey])
  @@index([ownerId])
  @@index([updatedAt])
}

model OpportunityStageHistory {
  id              String   @id @default(cuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage       String?
  toStage         String
  changedAt       DateTime @default(now())
  changedByUserId String?
  changedByUser   User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([changedAt])
  @@index([changedByUserId])
}

model AuditEvent {
  id          String   @id @default(cuid())
  category    String
  action      String
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  entityType  String?
  entityId    String?
  summary     String
  metadata    String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([action])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([occurredAt])
}
